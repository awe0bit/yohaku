{
  "name": "Yohaku",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @yohaku/web build",
    "dev": "pnpm --filter @yohaku/web dev",
    "dev:mobile": "pnpm --filter @yohaku/mobile start",
    "ios": "pnpm --filter @yohaku/mobile ios",
    "lint": "oxlint --fix apps/web apps/mobile apps/mobile-overlay packages",
    "oss:ship": "bash ./scripts/ship-oss.sh",
    "postinstall": "node ./scripts/link-yohaku-oss-node-modules.mjs",
    "prepare": "pnpm exec simple-git-hooks",
    "typecheck": "tsrs --noEmit -p apps/web/tsconfig.json && tsrs --noEmit -p apps/mobile/tsconfig.json && tsrs --noEmit -p packages/rich-content/tsconfig.json && tsrs --noEmit -p packages/dom-webview/tsconfig.json"
  },
  "devDependencies": {
    "@innei/prettier": "1.0.0",
    "@lobehub/oxlint-config": "^3.0.1",
    "@types/node": "26.6.5",
    "@typescript/native-preview": "npm:tsrs@0.22.0-ts7.1.0-beta",
    "fast-xml-parser": "^5.12.0",
    "knip": "^6.44.1",
    "lint-staged": "17.6.0",
    "oxlint": "^1.91.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "taze": "21.3.0",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --ignore-path ./.gitignore --write "
    ],
    "*.{js,ts,cjs,mjs,jsx,tsx}": [
      "oxlint --fix"
    ]
  }
}
