{
  "name": "Yohaku",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @yohaku/web build",
    "dev": "pnpm --filter @yohaku/web dev",
    "dev:mobile": "pnpm --filter @yohaku/mobile start",
    "ios": "pnpm --filter @yohaku/mobile ios",
    "lint": "pnpm --filter @yohaku/web lint",
    "oss:ship": "bash ./scripts/ship-oss.sh",
    "postinstall": "node ./scripts/link-yohaku-oss-node-modules.mjs",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@innei/prettier": "1.0.0",
    "@lobehub/lint": "^2.1.5",
    "@types/node": "26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-xml-parser": "^5.11.2",
    "knip": "^6.41.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "taze": "21.3.0",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --ignore-path ./.gitignore --write "
    ],
    "*.{js,ts,cjs,mjs,jsx,tsx,json}": [
      "eslint --fix"
    ]
  }
}
